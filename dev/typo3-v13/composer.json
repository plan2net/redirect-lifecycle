{
    "name": "plan2net/redirect-lifecycle-dev-13",
    "description": "TYPO3 13 development instance for redirect_lifecycle",
    "type": "project",
    "license": "GPL-2.0-only",
    "repositories": [
        {
            "type": "path",
            "url": "/opt/redirect-lifecycle",
            "options": {
                "symlink": true,
                "versions": {
                    "plan2net/redirect-lifecycle": "dev-main"
                }
            }
        }
    ],
    "require": {
        "plan2net/redirect-lifecycle": "dev-main",
        "typo3/cms-install": "^13.4",
        "typo3/minimal": "^13.4",
        "wazum/sluggi": "^14.15"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "typo3/testing-framework": "^9.7"
    },
    "autoload-dev": {
        "psr-4": {
            "Plan2net\\RedirectLifecycle\\Tests\\": "/opt/redirect-lifecycle/Tests/"
        }
    },
    "scripts": {
        "test:functional": "phpunit --bootstrap vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php --configuration /opt/redirect-lifecycle/Tests/Functional.xml"
    }
}
